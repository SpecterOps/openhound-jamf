# Allow only package build inputs. Credentials and local state stay outside the context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE.md
!extension.yaml
!src/
!src/**

# Also exclude sensitive or generated files if placed underneath src/.
**/.git
**/.codex
**/.dlt
**/.env
**/.env.*
**/.venv
**/venv
**/output
**/graph-output
**/logs
**/site
**/_build
**/__pycache__
**/*.py[cod]
**/*.duckdb*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.jwk
**/*.p8
**/id_ecdsa*
**/secrets.toml
**/config.toml
