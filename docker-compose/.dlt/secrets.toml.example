[destination.bloodhoundenterprise]
url = "https://REPLACE_WITH_TENANT.bloodhoundenterprise.io"
# Use a dedicated Jamf OpenHound collector client in BHE for this deployment.
token_id = "REPLACE_WITH_BHE_COLLECTOR_TOKEN_ID"
token_key = "REPLACE_WITH_BHE_COLLECTOR_TOKEN_KEY"

[sources.source.jamf.credentials]
host = "https://REPLACE_WITH_JAMF_HOST.jamfcloud.com"
# API client authentication:
client_id = "REPLACE_WITH_JAMF_CLIENT_ID"
client_secret = "REPLACE_WITH_JAMF_CLIENT_SECRET"
# Alternatively, remove BOTH client fields above and use username/password:
# username = "REPLACE_WITH_JAMF_USERNAME"
# password = "REPLACE_WITH_JAMF_PASSWORD"
